# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Credenciales que no son .env y que un `git add -A` barrería igual.
# Este repo es público: un archivo de códigos de recuperación aquí dentro se
# publica con el primer commit distraído. Lo correcto es guardarlos FUERA del
# repo (gestor de contraseñas); esto es la red, no la solución.
RECOVERY-CODES*
*recovery-codes*
*.key
*.pem
credentials*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env: el ejemplo SÍ se versiona (T003)
!.env.example

# playwright
/test-results/
/playwright-report/
/.playwright/

# asset fuente del hero (la copia servida vive en public/video/)
/Children*Running*To*Lawn*.webm
/Children*running*to*lawn*.mp4

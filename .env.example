# Copiar a .env.local para desarrollo:  cp .env.example .env.local
#
# Los valores con prefijo REEMPLAZAR_ son centinelas de placeholder (AS-01/AS-02).
# La guarda tests/unit/no-placeholder-contact.test.ts (T021), enganchada al
# "prebuild" desde T057, falla mientras alguno siga presente — eso es lo que
# impide que un deploy a producción salga con datos de contacto inventados.

# Resend — API key del proyecto. Requiere cuenta y dominio remitente
# verificado por DNS antes de producción (AS-02). En desarrollo sirve el
# modo sandbox de Resend.
RESEND_API_KEY=REEMPLAZAR_RESEND_API_KEY

# Buzón que recibe la notificación de cada lead.
LEADS_NOTIFY_EMAIL=REEMPLAZAR_leads@logibienes.example

# WhatsApp comercial en formato internacional sin "+" ni espacios (ej. 573001234567).
# Mientras sea el centinela, contact-cta.tsx (T013) cae al enlace a /contacto.
WHATSAPP_NUMBER=REEMPLAZAR_573000000000

# Remitente de la notificación de leads. Debe ser una dirección de un dominio
# verificado por DNS en Resend (AS-02). Sin definir, cae al remitente de
# sandbox de Resend, que solo sirve en desarrollo.
LEADS_FROM_EMAIL=

# Origen absoluto del sitio, sin barra final (ej. https://logibienes.com).
# Lo usan sitemap.xml, robots.txt, los canonical y el JSON-LD. En Vercel, si se
# deja vacío, se resuelve solo con VERCEL_PROJECT_PRODUCTION_URL; en local cae
# a http://localhost:3000. No lleva centinela a propósito: publicar un dominio
# inventado en datos estructurados es peor que no publicar ninguno.
NEXT_PUBLIC_SITE_URL=

# Secreto de la firma HMAC-SHA256 del formTimestamp (anti-spam sin estado
# compartido, research.md §5). Generar uno propio por entorno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No es un centinela: la guarda de T021 no lo revisa, pero tampoco debe
# viajar un valor real en este archivo.
LEADS_HMAC_SECRET=
